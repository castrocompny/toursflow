NEXT_PUBLIC_SITE_URL=https://toursflow.com.br

# URL base da API pública do NauticFlow (server-side only, sem NEXT_PUBLIC).
# Sem essa variável, o site usa os dados MOCK locais automaticamente.
# development: normalmente deixar vazia (usa mock).
# preview/production: https://nauticflow.com.br
NAUTICFLOW_API_URL=https://nauticflow.com.br

# Segredo compartilhado com o NauticFlow para POST /api/marketplace/bookings
# (rota de criação de reserva). Server-side only, NUNCA NEXT_PUBLIC — vazar
# isso permite criar reservas em nome de qualquer operador.
# O MESMO valor precisa estar configurado nos dois projetos (ToursFlow e
# NauticFlow). Sem essa variável, POST /api/bookings falha com
# INTERNAL_ERROR — nunca cai para um comportamento simulado.
# Nenhum valor real aqui.
TOURSFLOW_API_SECRET=

# URL e chave anônima do projeto Supabase do NauticFlow — usadas SÓ pra
# assinar public.marketplace_catalog_state via Realtime (Postgres Changes) e
# saber "algo no catálogo mudou, refaz a consulta" (CatalogRefresh, ver
# src/components/realtime/CatalogRefresh.tsx). NÃO são segredos — são os
# MESMOS dois valores já públicos no bundle do navegador do próprio
# NauticFlow (prefixo NEXT_PUBLIC_, protegidos por RLS/policy no banco,
# nunca por sigilo). Essa tabela só tem SELECT liberado pra anon, sem
# nenhum dado de passeio/operador/cliente/pagamento — ver migration
# 0069_marketplace_catalog_realtime_state.sql no repositório do NauticFlow.
# Sem essas duas variáveis, o site funciona normalmente (listTours()/
# getTour() já são no-store, sem cache velho) — só a atualização automática
# de aba já aberta fica desligada, sem erro nenhum.
NEXT_PUBLIC_NAUTICFLOW_SUPABASE_URL=https://your-nauticflow-project.supabase.co
NEXT_PUBLIC_NAUTICFLOW_SUPABASE_ANON_KEY=your-nauticflow-anon-key
